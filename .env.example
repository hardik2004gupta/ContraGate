# ContraGate Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Required for all environments ─────────────────────────────────────────────

# Claude Sonnet API key (Anthropic) — used for LLM calls and embeddings
ANTHROPIC_API_KEY=

# Application database — memory store, audit log, policy store
DATABASE_URL=postgresql://contragate:<DB_PASSWORD>@localhost:5432/contragate

# Staging database — transaction sandbox simulation ONLY (must NOT equal DATABASE_URL in production)
STAGING_DATABASE_URL=postgresql://contragate:<STAGING_DB_PASSWORD>@localhost:5432/contragate_staging

# Database passwords (used when constructing DATABASE_URL / STAGING_DATABASE_URL)
DB_PASSWORD=
STAGING_DB_PASSWORD=

# Tenant identifier — use demo_tenant for local development
CONTRAGATE_TENANT_ID=demo_tenant

# Set to 'true' for local dev without Docker (in-memory WorkflowStore)
# Set to 'false' in production — missing DB becomes a fatal startup error
DEV_MODE=true

# ── Required for production (Railway) only ────────────────────────────────────

# Slack bot token for the notifier MCP server
SLACK_BOT_TOKEN=

# Slack channel where approval notifications are posted
SLACK_APPROVAL_CHANNEL=

# Slack signing secret — validates incoming Slack webhook signatures
SLACK_SIGNING_SECRET=

# ── Optional / configurable overrides ────────────────────────────────────────

# Human review timeout in minutes (default: 30)
APPROVAL_TIMEOUT_MINUTES=30

# Human review timeout in seconds — used internally (default: 1800 = 30 min)
CONTRAGATE_TIMEOUT_SECONDS=1800

# Read Impact Gate EXPLAIN cost threshold (default: 50000)
# Operations above this cost are routed to standard review minimum
FAST_PATH_COST_THRESHOLD=50000
CONTRAGATE_EXPLAIN_THRESHOLD=50000

# Cascade row count threshold above which FULL_CONTRACT tier is forced
CASCADE_ROWS_FULL_CONTRACT=10000

# Sandbox statement timeout in milliseconds (default: 5000)
STATEMENT_TIMEOUT_MS=5000
SANDBOX_STATEMENT_TIMEOUT=5000

# Memory retrieval Jaccard similarity threshold (default: 0.3)
JACCARD_SIMILARITY_THRESHOLD=0.3

# FK cascade tracer maximum depth (default: 5)
MAX_CASCADE_DEPTH=5

# ── Local development only ────────────────────────────────────────────────────

# Set to 'true' to use local mock notifier instead of Slack
USE_MOCK_NOTIFIER=true

# Local mock notifier port
MOCK_NOTIFIER_PORT=8020

# ── Internal service URLs (for Docker Compose) ────────────────────────────────

# MCP server URLs
POSTGRES_READER_URL=http://localhost:8010
TRANSACTION_SANDBOX_URL=http://localhost:8011
MEMORY_STORE_URL=http://localhost:8012
AUDIT_LOGGER_URL=http://localhost:8013
POLICY_STORE_URL=http://localhost:8014
NOTIFIER_URL=http://localhost:8020

# Proxy and orchestrator URLs
PROXY_BASE_URL=http://localhost:8000
ORCHESTRATOR_URL=http://localhost:8001
PROXY_CALLBACK_URL=http://localhost:8000/v1/decisions

# Target MCP server URL (the real SQL execution endpoint)
TARGET_MCP_URL=http://localhost:8010

# UI base URL for approval links in Slack messages
UI_BASE_URL=http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────

# MCP server API key (shared secret between proxy and MCP servers)
CONTRAGATE_MCP_API_KEY=dev-mcp-key

# Set to 'false' in production to enforce API key authentication
USE_MOCK_AUTH=true
