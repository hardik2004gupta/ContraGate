{
  "name": "audit-logger",
  "version": "0.2.0",
  "description": "Append-only tamper-evident audit log with SHA-256 checksums per row. No UPDATE or DELETE from normal code paths.",
  "port": 8013,
  "tools": [
    {
      "name": "log_tool_call",
      "description": "Record an agent tool invocation with input/output hashes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": { "type": "string" },
          "agent_name": { "type": "string" },
          "tool_name": { "type": "string" },
          "input_hash": { "type": "string" },
          "output_hash": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "required": ["operation_id", "agent_name", "tool_name", "input_hash", "output_hash", "timestamp"]
      }
    },
    {
      "name": "log_agent_output",
      "description": "Record an agent's final structured output for a pipeline state.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": { "type": "string" },
          "agent_name": { "type": "string" },
          "output_summary": { "type": "string" },
          "handoff_contract_hash": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "required": ["operation_id", "agent_name", "output_summary", "handoff_contract_hash", "timestamp"]
      }
    },
    {
      "name": "log_human_decision",
      "description": "Append a human approval/rejection decision to the audit log.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": { "type": "string" },
          "decision": { "type": "string" },
          "reason": { "type": "string" },
          "approver_id": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "required": ["operation_id", "decision", "reason", "approver_id", "timestamp"]
      }
    },
    {
      "name": "log_execution",
      "description": "Append a completed execution record to the audit log.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": { "type": "string" },
          "execution_success": { "type": "boolean" },
          "actual_rows": { "type": "integer" },
          "blast_radius_delta": { "type": "number" },
          "timestamp": { "type": "string" }
        },
        "required": ["operation_id", "execution_success", "timestamp"]
      }
    },
    {
      "name": "log_auto_reject",
      "description": "Append an auto-rejection record citing the specific policy rule.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "operation_id": { "type": "string" },
          "rule_name": { "type": "string" },
          "matched_pattern": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "required": ["operation_id", "rule_name", "matched_pattern", "timestamp"]
      }
    },
    {
      "name": "list_operations",
      "description": "List completed operations for the audit log UI, paginated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" },
          "limit": { "type": "integer", "default": 50 },
          "offset": { "type": "integer", "default": 0 }
        },
        "required": ["tenant_id"]
      }
    },
    {
      "name": "verify_checksum",
      "description": "Verify the stored SHA-256 checksum matches the current row content for an operation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "record_id": { "type": "string" }
        },
        "required": ["record_id"]
      }
    }
  ]
}
